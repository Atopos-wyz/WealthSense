# 未同时配置 MySQL 与 Redis 时，应用自动使用内存适配器。
WEALTHSENSE_APP_ENV=development
WEALTHSENSE_MYSQL_URL=mysql+aiomysql://user:password@127.0.0.1:3306/wealthsense
WEALTHSENSE_REDIS_URL=redis://127.0.0.1:6379/0
WEALTHSENSE_CONFIRMATION_TTL_SECONDS=900
WEALTHSENSE_RISK_REVIEW_TTL_SECONDS=300
WEALTHSENSE_IDEMPOTENCY_TTL_SECONDS=3600
WEALTHSENSE_JWT_SECRET=replace-with-a-long-random-secret
WEALTHSENSE_JWT_ISSUER=wealthsense
WEALTHSENSE_CUSTOMER_EVENT_HMAC_SECRET=replace-customer-secret
WEALTHSENSE_ADVISOR_EVENT_HMAC_SECRET=replace-advisor-secret
WEALTHSENSE_RISK_EVENT_HMAC_SECRET=replace-risk-secret
WEALTHSENSE_ANALYST_EVENT_HMAC_SECRET=replace-analyst-secret
WEALTHSENSE_OPERATOR_EVENT_HMAC_SECRET=replace-operator-secret
WEALTHSENSE_EVENT_STREAM_KEY=agent:events:durable
