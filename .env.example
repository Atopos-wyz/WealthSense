# 公共基础设施配置
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=true

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ISSUER=wealthsense
JWT_AUDIENCE=wealthsense-api

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=finance
MYSQL_USER=finance_app
MYSQL_PASSWORD=replace-with-mysql-password
MYSQL_POOL_SIZE=5
MYSQL_MAX_OVERFLOW=10

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=replace-with-redis-password
REDIS_MAX_CONNECTIONS=20

NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-neo4j-password
NEO4J_DATABASE=neo4j
NEO4J_MAX_CONNECTION_POOL_SIZE=20

MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_USER=root
MILVUS_ROOT_PASSWORD=replace-with-milvus-password
MILVUS_DATABASE=default
DATABASE_CONNECT_TIMEOUT_SECONDS=5

# Business Operator Agent：未同时配置 URL 时使用内存适配器
WEALTHSENSE_APP_ENV=development
WEALTHSENSE_MYSQL_URL=mysql+aiomysql://user:password@127.0.0.1:3306/finance
WEALTHSENSE_REDIS_URL=redis://default:password@127.0.0.1:6379/0

WEALTHSENSE_SSH_TUNNEL_ENABLED=false
WEALTHSENSE_SSH_HOST=server.example.com
WEALTHSENSE_SSH_PORT=22
WEALTHSENSE_SSH_USERNAME=ubuntu
WEALTHSENSE_SSH_PASSWORD=replace-with-ssh-password
WEALTHSENSE_SSH_KNOWN_HOSTS=~/.ssh/known_hosts
WEALTHSENSE_SSH_REMOTE_MYSQL_HOST=127.0.0.1
WEALTHSENSE_SSH_REMOTE_MYSQL_PORT=3306
WEALTHSENSE_SSH_REMOTE_REDIS_HOST=127.0.0.1
WEALTHSENSE_SSH_REMOTE_REDIS_PORT=6379
WEALTHSENSE_SSH_KEEPALIVE_SECONDS=30

WEALTHSENSE_CONFIRMATION_TTL_SECONDS=900
WEALTHSENSE_RISK_REVIEW_TTL_SECONDS=300
WEALTHSENSE_IDEMPOTENCY_TTL_SECONDS=3600
WEALTHSENSE_JWT_SECRET=replace-with-a-long-random-secret
WEALTHSENSE_JWT_ISSUER=wealthsense
WEALTHSENSE_CUSTOMER_EVENT_HMAC_SECRET=replace-customer-secret
WEALTHSENSE_ADVISOR_EVENT_HMAC_SECRET=replace-advisor-secret
WEALTHSENSE_RISK_EVENT_HMAC_SECRET=replace-risk-secret
WEALTHSENSE_ANALYST_EVENT_HMAC_SECRET=replace-analyst-secret
WEALTHSENSE_OPERATOR_EVENT_HMAC_SECRET=replace-operator-secret
WEALTHSENSE_EVENT_STREAM_KEY=agent:events:durable

# Business Operator Agent: OpenAI-compatible intent recognition.
# Leave any of BASE_URL/API_KEY/MODEL empty to use keyword fallback only.
WEALTHSENSE_LLM_BASE_URL=https://api.deepseek.com
WEALTHSENSE_LLM_API_KEY=replace-with-llm-api-key
WEALTHSENSE_LLM_MODEL=deepseek-v4-flash
WEALTHSENSE_LLM_TIMEOUT_SECONDS=10
WEALTHSENSE_LLM_CONFIDENCE_THRESHOLD=0.75

# ---------------------------------------------------------------------------
# 风控监测 P7 联调（复制到 .env 后按本机情况改）
# 若使用 scripts/ssh_tunnel.py：本地 MySQL=13306、Redis=16379
# ---------------------------------------------------------------------------
# 预警落库：memory=进程内；mysql=写入 fin_risk_alert（联调必须用 mysql）
RISK_ALERT_STORE=mysql
# 亦可写：WEALTHSENSE_RISK_ALERT_STORE=mysql

# 隧道联调示例（隧道已开时取消注释并改密码）
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=13306
# MYSQL_DATABASE=finance
# MYSQL_USER=finance_app
# MYSQL_PASSWORD=your-mysql-password
# REDIS_HOST=127.0.0.1
# REDIS_PORT=16379
# REDIS_DB=0
# REDIS_PASSWORD=your-redis-password

# 风控隔离 LLM：联调先用 mock 即可；真调再改 http 并填下面三项
RISK_LLM_MODE=mock
# RISK_LLM_MODE=http
# RISK_LLM_BASE_URL=https://api.example.com
# RISK_LLM_API_KEY=replace-with-risk-llm-key
# RISK_LLM_MODEL=your-model-name
# RISK_LLM_TIMEOUT_SECONDS=10
# 亦可使用 WEALTHSENSE_RISK_LLM_* 前缀
