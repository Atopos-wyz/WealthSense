# 应用配置
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=true

# Mock JWT / RBAC 权限
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ISSUER=wealthsense
JWT_AUDIENCE=wealthsense-api

# MySQL 配置
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=finance
MYSQL_USER=finance_app
MYSQL_PASSWORD=replace-with-mysql-password
MYSQL_POOL_SIZE=5
MYSQL_MAX_OVERFLOW=10

# Redis 配置
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=replace-with-redis-password
REDIS_MAX_CONNECTIONS=20

# Neo4j 配置
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-neo4j-password
NEO4J_DATABASE=neo4j
NEO4J_MAX_CONNECTION_POOL_SIZE=20

# Milvus 配置
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_USER=root
MILVUS_ROOT_PASSWORD=replace-with-milvus-password
MILVUS_DATABASE=default

# 公共数据库配置
DATABASE_CONNECT_TIMEOUT_SECONDS=5

# RAG / Agent 配置
EMBEDDING_PROVIDER=bge
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=16
KNOWLEDGE_CHUNK_SIZE=512
KNOWLEDGE_CHUNK_OVERLAP=64
KNOWLEDGE_SEARCH_MIN_SCORE=0.7
SESSION_TTL_SECONDS=1800
SESSION_MAX_MESSAGES=20
SESSION_TOKEN_BUDGET=4096
NL2SQL_CACHE_TTL_SECONDS=600
NL2SQL_MAX_ROWS=100

# 可选：OpenAI 兼容 LLM；未配置时使用可测试的本地降级实现
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen3.7-plus
LLM_ENABLE_THINKING=false
LLM_TIMEOUT_SECONDS=30
