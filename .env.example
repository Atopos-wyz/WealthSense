# Application
APP_NAME=WealthSense
APP_VERSION=0.1.0

# MySQL through SSH tunnel
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_TUNNEL_PORT=13306
MYSQL_DATABASE=finance
MYSQL_USER=finance_app
MYSQL_PASSWORD=replace_me
MYSQL_ROOT_PASSWORD=replace_me
DATABASE_URL=mysql+aiomysql://finance_app:replace_me@127.0.0.1:3306/finance

# SSH server (password/private key is intentionally not stored here)
SSH_HOST=your-cloud-server
SSH_USER=ubuntu
