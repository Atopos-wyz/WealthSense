# 应用配置
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=true

# Mock JWT / RBAC 权限
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ISSUER=wealthsense
JWT_AUDIENCE=wealthsense-api

# MySQL 配置
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_TUNNEL_PORT=13306
MYSQL_DATABASE=finance
MYSQL_USER=finance_app
MYSQL_PASSWORD=replace-with-mysql-password
MYSQL_POOL_SIZE=5
MYSQL_MAX_OVERFLOW=10

# Redis 配置
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=replace-with-redis-password
REDIS_MAX_CONNECTIONS=20

# Neo4j 配置
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-neo4j-password
NEO4J_DATABASE=neo4j
NEO4J_MAX_CONNECTION_POOL_SIZE=20

# Milvus 配置
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_USER=root
MILVUS_ROOT_PASSWORD=replace-with-milvus-password
MILVUS_DATABASE=default

# 公共数据库配置
DATABASE_CONNECT_TIMEOUT_SECONDS=5

# 云端SSH隧道（密码不写入配置文件）
SSH_HOST=your-cloud-server
SSH_USER=ubuntu
